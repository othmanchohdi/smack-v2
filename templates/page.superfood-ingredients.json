          "settings": {
            "image": "shopify://shop_images/gempages_485391223989732606-48896c5d-29f0-42fd-b65e-f77dc2577842.webp",
            "ingredient_type": "plant",
            "title": "Organic Shiitake Mushroom",
            "description": "<p>Shiitake mushrooms are a delicious superfood with a rich, savoury taste that aligns with pets' natural preferences. This perfectly complements our whole-prey proteins, maximizing the appeal for pets! Far from just a tasty ingredient, they're packed with essential vitamins and minerals linked to improved coat and skin health. The triterpenes in shiitake have antibacterial and antiviral effects which improve the immune system. Shiitake mushrooms also contain natural compounds that improve dental health, reduce inflammation, and promote healthy circulation.</p>",
            "tag_1": "Organic",
            "tag_1_bg": "#d6249f",
