          "settings": {
            "image": "shopify://shop_images/gempages_485391223989732606-b8b518cf-3072-4a0e-9aa4-53c6384dd7fc.webp",
            "ingredient_type": "plant",
            "title": "Organic Coconut",
            "description": "<p>Smack Pet Food uses organic GMO-free coconut to support healthy digestion and nutrient absorption. Studies have found that coconut can help fight viral, fungal, and parasitic infection. Coconut relives symptoms of ulerative colitis, stomach ulcers, reduces inflammation, and improves immune function as well as improve thyroid function.</p>",
            "tag_1": "Organic",
