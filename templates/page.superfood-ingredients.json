        "ingredient_Lc8fYH": {
          "type": "ingredient",
          "settings": {
            "image": "shopify://shop_images/gempages_485391223989732606-4d90febe-03a0-4b49-9b3a-7c816b4f34f1.webp",
            "ingredient_type": "plant",
            "title": "Organic Pineapple",
            "description": "<p>Smack uses organic GMO-free pineapple grown on certified organic farms in Costa Rica. Pineapple contain high amounts of a complex substance called bromelain, which facilitates in protein digestion. However, the benefits don't stop there! Studies on bromelain have shown that it reduces growth of certain tumors. The use of bromelain is popular among athletes for its ability to reduce muscle aches and inflammation, important for speedy muscle recovery!</p>",
            "tag_1": "Organic",
