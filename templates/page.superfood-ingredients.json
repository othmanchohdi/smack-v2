          "settings": {
            "image": "shopify://shop_images/gempages_485391223989732606-da2f3bb8-0314-4ef8-b3ec-c36b7a378c91.webp",
            "ingredient_type": "plant",
            "title": "Organic Spinach",
            "description": "<p>Smack Pet Food uses organic GMO-free spinach grown on Canadian farms. Recent studies have shown that glycoclycerolipids in spinach help protect the lining of the digestive tract from damage – especially damage related to inflammation. In a recent study, out of 9 vegetables, including kale, spinach was the only one to show evidence of significant protection against certain aggressive and early stage cancers. This is due to unusually high amounts of epoxyxanthophylls found in the leaves of spinach. Research of spinach has also linked improved eye-health and consumption of spinach, especially the reduction of macular degeneration and other age-related eye problems.</p>",
            "tag_1": "Organic",
            "tag_1_bg": "#d6249f",
            "tag_1_text": "#ffffff",
