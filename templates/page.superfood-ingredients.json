        "ingredient_B3iLmW": {
          "type": "ingredient",
          "settings": {
            "image": "shopify://shop_images/gempages_485391223989732606-6ba4b755-d39a-407e-8245-abe08bca7aa9.webp",
            "ingredient_type": "plant",
            "title": "Organic Carrot",
            "description": "<p>Smack Pet Food uses organic GMO-free carrots grown in Canada. The 3 main areas of benefits related to consumption of carrots are: Vision Health, Cancer Fighting, and Cardiovascular Health. According to a new, 10-year long study, carrots were shown to be the most effective food for reducing cardiovascular disease when consumed in regular, “low” amounts. In studies on the risk of cataracts in animals, geranyl acetate, a substance in carrots, was repeatedly shown to reduce the risk of cataracts. Studies show that carrot extract has the powerful ability to inhibit the growth of cancer cells in the colon.</p>",
            "tag_1": "Organic",
            "tag_1_bg": "#d6249f",
            "tag_1_text": "#ffffff",
