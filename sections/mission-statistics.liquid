{%- comment -%}
  /sections/mission-statistics.liquid

  Statistics row for values such as ratings, percentages, rankings,
  and supporting labels. Includes responsive columns and optional dividers.
{%- endcomment -%}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign animation_anchor = '#mission-statistics-' | append: section.id
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
  --stat-gap: {{ section.settings.gap }}px;
  --stat-divider: {{ section.settings.divider_color }};
  --stat-number-size: {{ section.settings.number_size }}px;
  --stat-label-size: {{ section.settings.label_size }}px;
{%- endcapture -%}

<section
  id="mission-statistics-{{ section.id }}"
  class="mission-statistics section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="mission-statistics"
  style="{{ style }}"
>
  <div class="{{ section.settings.width }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="mission-statistics__header mission-statistics__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <div
            class="mission-statistics__eyebrow"
            data-animation="fade-up"
            data-animation-anchor="{{ animation_anchor }}"
          >
            {{ section.settings.eyebrow | escape }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }}
            class="mission-statistics__heading {{ section.settings.heading_size }}"
            data-animation="fade-up"
            data-animation-anchor="{{ animation_anchor }}"
            data-animation-delay="75"
          >
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div
            class="mission-statistics__text {{ section.settings.text_size }}"
            data-animation="fade-up"
            data-animation-anchor="{{ animation_anchor }}"
            data-animation-delay="150"
          >
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="mission-statistics__grid{% if section.settings.show_dividers %} mission-statistics__grid--dividers{% endif %}"
        style="--desktop-columns: {{ section.settings.columns_desktop }}; --mobile-columns: {{ section.settings.columns_mobile }};"
      >
        {%- for block in section.blocks -%}
          <div
            class="mission-statistics__item"
            {{ block.shopify_attributes }}
            data-animation="fade-up"
            data-animation-anchor="{{ animation_anchor }}"
            data-animation-delay="{{ forloop.index0 | times: 75 }}"
          >
            {%- if block.settings.icon != blank -%}
              <div class="mission-statistics__icon">
                {{
                  block.settings.icon
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '48, 72, 96, 120, 160',
                    sizes: '48px',
                    alt: block.settings.icon.alt
                }}
              </div>
            {%- endif -%}

            <div class="mission-statistics__number">
              {%- if block.settings.prefix != blank -%}
                <span class="mission-statistics__prefix">{{ block.settings.prefix | escape }}</span>
              {%- endif -%}

              <span>{{ block.settings.number | escape }}</span>

              {%- if block.settings.suffix != blank -%}
                <span class="mission-statistics__suffix">{{ block.settings.suffix | escape }}</span>
              {%- endif -%}
            </div>

            {%- if block.settings.label != blank -%}
              <div class="mission-statistics__label">
                {{ block.settings.label }}
              </div>
            {%- endif -%}

            {%- if block.settings.subtext != blank -%}
              <div class="mission-statistics__subtext">
                {{ block.settings.subtext }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="mission-statistics__empty">
        Add statistic blocks to display ratings, percentages, rankings, or milestones.
      </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #mission-statistics-{{ section.id }} .mission-statistics__header {
    max-width: 760px;
    margin-bottom: 34px;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__header--left {
    margin-right: auto;
    text-align: left;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__header--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__header--right {
    margin-left: auto;
    text-align: right;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__eyebrow {
    margin-bottom: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__heading {
    margin: 0;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__text {
    margin-top: 12px;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__text > *:first-child,
  #mission-statistics-{{ section.id }} .mission-statistics__label > *:first-child,
  #mission-statistics-{{ section.id }} .mission-statistics__subtext > *:first-child {
    margin-top: 0;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__text > *:last-child,
  #mission-statistics-{{ section.id }} .mission-statistics__label > *:last-child,
  #mission-statistics-{{ section.id }} .mission-statistics__subtext > *:last-child {
    margin-bottom: 0;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__grid {
    display: grid;
    grid-template-columns: repeat(var(--desktop-columns), minmax(0, 1fr));
    gap: var(--stat-gap);
    align-items: stretch;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.stat_alignment }};
    justify-content: center;
    min-width: 0;
    padding: 10px 24px;
    text-align: {{ section.settings.stat_alignment }};
  }

  #mission-statistics-{{ section.id }} .mission-statistics__grid--dividers .mission-statistics__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 12%;
    right: calc(var(--stat-gap) / -2);
    width: 1px;
    height: 76%;
    background: var(--stat-divider);
  }

  #mission-statistics-{{ section.id }} .mission-statistics__icon {
    width: {{ section.settings.icon_size }}px;
    margin-bottom: 12px;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__icon img {
    display: block;
    width: 100%;
    height: auto;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__number {
    display: flex;
    align-items: baseline;
    justify-content: inherit;
    gap: 2px;
    font-size: var(--stat-number-size);
    font-weight: {{ section.settings.number_weight }};
    line-height: 1;
    letter-spacing: {{ section.settings.number_letter_spacing }}em;
    white-space: nowrap;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__prefix,
  #mission-statistics-{{ section.id }} .mission-statistics__suffix {
    font-size: 0.7em;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__label {
    margin-top: 10px;
    font-size: var(--stat-label-size);
    line-height: 1.35;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__subtext {
    margin-top: 5px;
    font-size: 0.75rem;
    line-height: 1.4;
    opacity: 0.68;
  }

  #mission-statistics-{{ section.id }} .mission-statistics__empty {
    padding: 30px;
    text-align: center;
    border: 1px dashed currentColor;
    opacity: 0.65;
  }

  @media screen and (max-width: 989px) {
    #mission-statistics-{{ section.id }} .mission-statistics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__grid--dividers .mission-statistics__item::after {
      display: none;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__grid--dividers .mission-statistics__item:nth-child(odd)::after {
      display: block;
      top: 8%;
      right: calc(var(--stat-gap) / -2);
      height: 84%;
    }
  }

  @media screen and (max-width: 749px) {
    #mission-statistics-{{ section.id }} .mission-statistics__header {
      margin-bottom: 26px;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__grid {
      grid-template-columns: repeat(var(--mobile-columns), minmax(0, 1fr));
      gap: {{ section.settings.mobile_gap }}px;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__item {
      padding: 12px 10px;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__number {
      font-size: {{ section.settings.mobile_number_size }}px;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__label {
      font-size: {{ section.settings.mobile_label_size }}px;
    }

    #mission-statistics-{{ section.id }} .mission-statistics__grid--dividers .mission-statistics__item::after {
      display: none;
    }

    {% if section.settings.columns_mobile == 2 %}
      #mission-statistics-{{ section.id }} .mission-statistics__grid--dividers .mission-statistics__item:nth-child(odd)::after {
        display: block;
        top: 10%;
        right: calc({{ section.settings.mobile_gap }}px / -2);
        height: 80%;
      }
    {% endif %}
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Mission statistics",
  "class": "section-mission-statistics",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "heading-medium",
      "options": [
        { "value": "heading-x-small", "label": "Extra small" },
        { "value": "heading-small", "label": "Small" },
        { "value": "heading-medium", "label": "Medium" },
        { "value": "heading-large", "label": "Large" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "default": "body-medium",
      "options": [
        { "value": "body-small", "label": "Small" },
        { "value": "body-medium", "label": "Medium" },
        { "value": "body-large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        { "value": "wrapper", "label": "Wrapper" },
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper--full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#d9dde7"
    },
    {
      "type": "select",
      "id": "stat_alignment",
      "label": "Statistic alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Desktop number size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_number_size",
      "label": "Mobile number size",
      "min": 22,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "select",
      "id": "number_weight",
      "label": "Number weight",
      "default": "700",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    {
      "type": "range",
      "id": "number_letter_spacing",
      "label": "Number letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "em",
      "default": 0
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Desktop label size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_label_size",
      "label": "Mobile label size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Optional icon"
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "50,784"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix"
        },
        {
          "type": "richtext",
          "id": "label",
          "label": "Label",
          "default": "<p>Verified global ratings</p>"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Optional supporting text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Mission statistics",
      "category": "Text",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "50,784",
            "label": "<p>Verified global ratings</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "4.4 / 5",
            "suffix": "★",
            "label": "<p>Average rating across products</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "84",
            "suffix": "%",
            "label": "<p>Rated 4 stars or higher</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "prefix": "#",
            "number": "1",
            "label": "<p>Cooling brand in America</p>"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
