{% capture children %}

  {%- style -%}
    #shopify-section-{{ section.id }} .timeline-header {
      text-align: {{ section.settings.header_alignment }};
      margin-bottom: {{ section.settings.header_mb }}px;
    }
    #shopify-section-{{ section.id }} .timeline-section-heading {
      font-family: {{ section.settings.heading_font }};
      font-size: {{ section.settings.heading_font_size }};
      line-height: {{ section.settings.heading_line_height }};
      letter-spacing: {{ section.settings.heading_letter_spacing }};
      text-transform: {{ section.settings.heading_case }};
      color: {{ section.settings.heading_color }};
      margin: 0 0 {{ section.settings.heading_mb }}px;
    }
    #shopify-section-{{ section.id }} .timeline-section-description {
      font-family: {{ section.settings.description_font }};
      font-size: {{ section.settings.description_font_size }};
      line-height: {{ section.settings.description_line_height }};
      letter-spacing: {{ section.settings.description_letter_spacing }};
      text-transform: {{ section.settings.description_case }};
      color: {{ section.settings.description_color }};
      margin: 0;
    }
    #shopify-section-{{ section.id }} .timeline-line {
      background-color: {{ section.settings.line_color }};
    }
    #shopify-section-{{ section.id }} .timeline-dot {
      background-color: {{ section.settings.dot_color }};
    }
    #shopify-section-{{ section.id }} .timeline-card {
      background-color: {{ section.settings.card_background }};
      {% if section.settings.card_shadow %}box-shadow: 0 4px 24px rgba(0,0,0,0.07);{% endif %}
    }
    #shopify-section-{{ section.id }} .timeline-label {
      background-color: {{ section.settings.label_background }};
      color: {{ section.settings.label_text_color }};
      font-family: {{ section.settings.label_font }};
      font-size: {{ section.settings.label_font_size }};
      letter-spacing: {{ section.settings.label_letter_spacing }};
      text-transform: {{ section.settings.label_case }};
    }
    #shopify-section-{{ section.id }} .timeline-card-title {
      color: {{ section.settings.card_title_color }};
      font-family: {{ section.settings.card_title_font }};
      font-size: {{ section.settings.card_title_font_size }};
      line-height: {{ section.settings.card_title_line_height }};
      letter-spacing: {{ section.settings.card_title_letter_spacing }};
      text-transform: {{ section.settings.card_title_case }};
    }
    #shopify-section-{{ section.id }} .timeline-card-text {
      color: {{ section.settings.card_text_color }};
      font-family: {{ section.settings.card_text_font }};
      font-size: {{ section.settings.card_text_font_size }};
      line-height: {{ section.settings.card_text_line_height }};
      letter-spacing: {{ section.settings.card_text_letter_spacing }};
      text-transform: {{ section.settings.card_text_case }};
    }
  {%- endstyle -%}

  {%- if section.settings.heading != blank or section.settings.description != blank -%}
    <div class="timeline-header">
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="timeline-section-heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="timeline-section-description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="timeline-container">
    <div class="timeline-line"></div>

    {%- for block in section.blocks -%}
      {%- assign is_right = forloop.index | modulo: 2 -%}
      <div
        class="timeline-item timeline-item--{% if is_right == 1 %}right{% else %}left{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          {%- if block.settings.label != blank -%}
            <span class="timeline-label">{{ block.settings.label }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="timeline-card-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="timeline-card-text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <style>
    #shopify-section-{{ section.id }} .timeline-header {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .timeline-container {
      position: relative;
      padding: 16px 0;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .timeline-line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 2px;
      z-index: 0;
    }

    #shopify-section-{{ section.id }} .timeline-item {
      position: relative;
      display: flex;
      align-items: flex-start;
      margin-bottom: {{ section.settings.items_gap }}px;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .timeline-item--right {
      justify-content: flex-end;
    }

    #shopify-section-{{ section.id }} .timeline-item--left {
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .timeline-dot {
      position: absolute;
      left: 50%;
      top: 20px;
      transform: translate(-50%, -50%);
      width: {{ section.settings.dot_size }}px;
      height: {{ section.settings.dot_size }}px;
      border-radius: 50%;
      z-index: 2;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .timeline-card {
      width: calc(50% - {{ section.settings.card_offset }}px);
      border-radius: {{ section.settings.card_border_radius }}px;
      padding: {{ section.settings.card_padding }}px;
      position: relative;
      z-index: 1;
    }

    #shopify-section-{{ section.id }} .timeline-label {
      display: inline-block;
      padding: 4px 14px;
      border-radius: 20px;
      font-weight: 500;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .timeline-card-title {
      margin: 0 0 10px;
    }

    #shopify-section-{{ section.id }} .timeline-card-text p {
      margin: 0;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .timeline-line {
        left: 16px;
        transform: none;
      }

      #shopify-section-{{ section.id }} .timeline-item--right,
      #shopify-section-{{ section.id }} .timeline-item--left {
        justify-content: flex-end;
      }

      #shopify-section-{{ section.id }} .timeline-dot {
        left: 16px;
        transform: translate(-50%, -50%);
      }

      #shopify-section-{{ section.id }} .timeline-card {
        width: calc(100% - 48px);
        padding: 18px;
      }
    }
  </style>

{% endcapture %}

{% render 'section', section: section, children: children %}

