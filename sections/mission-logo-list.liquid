{%- comment -%}
  /sections/mission-logo-list.liquid

  "As seen in" logo strip with editable heading, logo blocks,
  grayscale controls, spacing, and mobile horizontal scrolling.
{%- endcomment -%}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign animation_anchor = '#mission-logo-list-' | append: section.id
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
  --logo-gap: {{ section.settings.logo_gap }}px;
  --logo-height: {{ section.settings.logo_height }}px;
  --logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
  --logo-bg: {{ section.settings.logo_background }};
{%- endcapture -%}

<section
  id="mission-logo-list-{{ section.id }}"
  class="mission-logo-list section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="mission-logo-list"
  style="{{ style }}"
>
  <div class="{{ section.settings.width }}">
    {%- if section.settings.heading != blank -%}
      <div
        class="mission-logo-list__heading"
        data-animation="fade-up"
        data-animation-anchor="{{ animation_anchor }}"
      >
        <{{ section.settings.heading_tag }} class="{{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mission-logo-list__viewport{% if section.settings.mobile_scroll %} mission-logo-list__viewport--scroll{% endif %}">
        <div class="mission-logo-list__track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign logo = block.settings.logo
              assign logo_link = block.settings.link
              assign logo_alt = block.settings.alt_text

              if logo_alt == blank and logo != blank
                assign logo_alt = logo.alt
              endif
            -%}

            <div
              class="mission-logo-list__item"
              {{ block.shopify_attributes }}
              data-animation="fade-up"
              data-animation-anchor="{{ animation_anchor }}"
              data-animation-delay="{{ forloop.index0 | times: 75 }}"
            >
              {%- capture logo_markup -%}
                <div class="mission-logo-list__logo-wrap">
                  {%- if logo != blank -%}
                    {{
                      logo
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 180, 240, 320, 480, 600',
                        sizes: '(min-width: 990px) 180px, 140px',
                        class: 'mission-logo-list__logo',
                        alt: logo_alt
                    }}
                  {%- else -%}
                    <div class="mission-logo-list__placeholder">
                      {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endcapture -%}

              {%- if logo_link != blank -%}
                <a
                  class="mission-logo-list__link"
                  href="{{ logo_link }}"
                  {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
                  aria-label="{{ logo_alt | default: 'Featured publication' | escape }}"
                >
                  {{ logo_markup }}
                </a>
              {%- else -%}
                {{ logo_markup }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="mission-logo-list__empty">
        <p>Add logo blocks to display publications, partners, or press mentions.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #mission-logo-list-{{ section.id }} {
    overflow: hidden;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__heading {
    margin-bottom: 24px;
    text-align: {{ section.settings.heading_alignment }};
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__heading > * {
    margin: 0;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__viewport {
    width: 100%;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__track {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--logo-gap);
    align-items: stretch;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__item {
    min-width: 0;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__link,
  #mission-logo-list-{{ section.id }} .mission-logo-list__logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(var(--logo-height) + 36px);
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__logo-wrap {
    padding: 18px 20px;
    background: var(--logo-bg);
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__link {
    color: inherit;
    text-decoration: none;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: var(--logo-height);
    object-fit: contain;
    opacity: var(--logo-opacity);
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease;
    {% if section.settings.grayscale %}
      filter: grayscale(1);
    {% endif %}
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__link:hover .mission-logo-list__logo,
  #mission-logo-list-{{ section.id }} .mission-logo-list__link:focus-visible .mission-logo-list__logo {
    opacity: 1;
    transform: translateY(-2px);
    {% if section.settings.grayscale %}
      filter: grayscale(0);
    {% endif %}
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__placeholder {
    width: 100%;
    max-width: 170px;
    opacity: 0.35;
  }

  #mission-logo-list-{{ section.id }} .mission-logo-list__empty {
    padding: 30px;
    text-align: center;
    border: 1px dashed currentColor;
    opacity: 0.65;
  }

  @media screen and (max-width: 989px) {
    #mission-logo-list-{{ section.id }} .mission-logo-list__track {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #mission-logo-list-{{ section.id }} .mission-logo-list__heading {
      margin-bottom: 18px;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__track {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ section.settings.mobile_gap }}px;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__viewport--scroll {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 8px;
      margin-bottom: -8px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__viewport--scroll::-webkit-scrollbar {
      display: none;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__viewport--scroll .mission-logo-list__track {
      display: flex;
      width: max-content;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__viewport--scroll .mission-logo-list__item {
      flex: 0 0 {{ section.settings.mobile_item_width }}px;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__link,
    #mission-logo-list-{{ section.id }} .mission-logo-list__logo-wrap {
      min-height: calc({{ section.settings.mobile_logo_height }}px + 28px);
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__logo {
      height: {{ section.settings.mobile_logo_height }}px;
    }

    #mission-logo-list-{{ section.id }} .mission-logo-list__logo-wrap {
      padding: 14px 16px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Mission logo list",
  "class": "section-mission-logo-list",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN IN"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "heading-mini",
      "options": [
        { "value": "heading-mini", "label": "Mini" },
        { "value": "heading-x-small", "label": "Extra small" },
        { "value": "heading-small", "label": "Small" },
        { "value": "heading-medium", "label": "Medium" }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        { "value": "wrapper", "label": "Wrapper" },
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper--full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "mobile_scroll",
      "label": "Enable horizontal scrolling on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_item_width",
      "label": "Mobile item width",
      "min": 110,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "header",
      "content": "Logo appearance"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Desktop logo height",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_logo_height",
      "label": "Mobile logo height",
      "min": 18,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in grayscale",
      "default": true
    },
    {
      "type": "color",
      "id": "logo_background",
      "label": "Logo tile background",
      "default": "#f5f5f3"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Mission logo list",
      "category": "Text",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
