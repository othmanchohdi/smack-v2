<div
  id="wholesale-app"
  data-collection="{{ section.settings.wholesale_products_collection | escape }}"
  data-min-cart="{{ section.settings.fnd_wholesale_by_total }}"
></div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var elem = document.querySelector('#wholesale-app');
    var collection = elem.dataset.collection;
    var minCartValue = parseInt(elem.dataset.minCart, 10) || 0;

    function toCents(price) {
      return price ? Math.round(parseFloat(price) * 100) : null;
    }

    function fetchPage(page, accumulated) {
      return fetch('/collections/' + collection + '/products.json?limit=250&page=' + page)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var batch = data.products || [];
          accumulated = accumulated.concat(batch);
          if (batch.length === 250) {
            return fetchPage(page + 1, accumulated);
          }
          return accumulated;
        });
    }

    fetchPage(1, []).then(function(rawProducts) {
      var products = rawProducts.map(function(p) {
        var firstVariant = p.variants[0] || {};
        return {
          available:                 p.variants.some(function(v) { return v.available; }),
          title:                     p.title,
          id:                        p.id,
          featured_image:            p.images && p.images[0] ? p.images[0].src : null,
          price:                     toCents(firstVariant.price),
          original_price:            toCents(firstVariant.price),
          compare_at_price:          toCents(firstVariant.compare_at_price),
          original_compare_at_price: toCents(firstVariant.compare_at_price),
          tags:                      p.tags,
          type:                      p.product_type,
          handle:                    p.handle,
          vendor:                    p.vendor,
          variants: p.variants.map(function(v) {
            return {
              available:                 v.available,
              title:                     v.title,
              id:                        v.id,
              featured_image:            v.featured_image ? v.featured_image.src : null,
              price:                     toCents(v.price),
              original_price:            toCents(v.price),
              compare_at_price:          toCents(v.compare_at_price),
              original_compare_at_price: toCents(v.compare_at_price),
              quantity:                  v.inventory_quantity || 0
            };
          })
        };
      });

      FND.BUILDS.Page.WholeSaleApp({ minCartValue: minCartValue, products: products }, elem);
    });
  });
</script>

{% schema %}
{
  "name": "FND Wholesale App",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "wholesale_products_collection",
      "label": "Wholesale Products Collection"
    },
    {
      "type": "number",
      "id": "fnd_wholesale_by_total",
      "label": "Minimum Cart Value (cents)",
      "info": "In cents, e.g. 45000 = $450.00. Passed to the FND wholesale app as minCartValue.",
      "default": 45000
    }
  ],
  "presets": [
    {
      "name": "FND Wholesale App",
      "category": "FND Wholesale App"
    }
  ]
}
{% endschema %}
