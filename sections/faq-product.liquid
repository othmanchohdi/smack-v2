{%- liquid
  comment
    Product FAQ section
    Metaobject type: products_faqs
    Product metafield: custom.faq_content (single object reference, NOT a list)
    Field keys:
      product_title  (internal label, not rendered)
      Q1..15 -> question_1 ... question_15
      A1..15 -> answer_1 ... answer_15   (Rich text -> | metafield_tag)
    Source:
      1. Product metafield custom.faq_content
      2. Fallback: a faq object picked in section settings
  endcomment
  assign faq = product.metafields.custom.faq_content.value
  if faq == blank
    assign faq = section.settings.faq_object
  endif
  assign icon = '<svg class="faq-item__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'
-%}

{%- capture items_html -%}
  {%- if faq.question_1 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_1 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_1 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_2 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_2 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_2 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_3 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_3 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_3 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_4 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_4 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_4 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_5 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_5 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_5 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_6 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_6 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_6 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_7 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_7 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_7 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_8 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_8 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_8 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_9 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_9 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_9 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_10 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_10 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_10 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_11 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_11 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_11 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_12 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_12 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_12 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_13 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_13 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_13 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_14 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_14 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_14 | metafield_tag }}</div></details>{%- endif -%}
  {%- if faq.question_15 != blank -%}<details class="faq-item" data-faq-item><summary class="faq-item__question"><span>{{ faq.question_15 }}</span>{{ icon }}</summary><div class="faq-item__answer">{{ faq.answer_15 | metafield_tag }}</div></details>{%- endif -%}
{%- endcapture -%}
{%- assign items_html = items_html | strip -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --faq-bg: {{ section.settings.bg_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-border: {{ section.settings.border_color }};
    --faq-accent: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .faq-collection {
    background: var(--faq-bg);
    color: var(--faq-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .faq-collection__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .faq-collection__heading {
    text-align: {{ section.settings.heading_alignment }};
    margin: 0 0 1.75rem;
  }

  #shopify-section-{{ section.id }} .faq-category__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #shopify-section-{{ section.id }} .faq-item {
    border: 1px solid var(--faq-border);
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    background: var(--faq-bg);
  }

  #shopify-section-{{ section.id }} .faq-item__question {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .faq-item__question::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .faq-item__question::marker { content: ""; }

  #shopify-section-{{ section.id }} .faq-item__icon {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    transition: transform 0.25s ease;
    color: var(--faq-accent);
  }

  #shopify-section-{{ section.id }} .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .faq-item__answer {
    padding: 0 1.25rem 1.2rem;
    line-height: 1.65;
    animation: faqFade-{{ section.id }} 0.25s ease;
  }

  #shopify-section-{{ section.id }} .faq-item__answer > :first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .faq-item__answer > :last-child  { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .faq-item__answer a { color: var(--faq-accent); }

  @keyframes faqFade-{{ section.id }} {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  #shopify-section-{{ section.id }} .faq-collection__empty {
    padding: 1rem;
    border: 1px dashed var(--faq-border);
    border-radius: 8px;
    opacity: 0.8;
  }
{%- endstyle -%}

{%- if request.design_mode or items_html != blank -%}
<div class="faq-collection">
  <div class="faq-collection__inner page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="faq-collection__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if items_html != blank -%}
      <div class="faq-category__list" data-faq-list data-single-open="{{ section.settings.single_open }}">
        {{ items_html }}
      </div>
    {%- elsif request.design_mode -%}
      <div class="faq-collection__empty">
        No FAQs to show. Set the <strong>custom.faq_content</strong> metafield on this product,
        or pick a FAQ object in this section's settings &rarr; <em>Fallback content</em>.
      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var lists = root.querySelectorAll('[data-faq-list]');
    lists.forEach(function (list) {
      if (list.getAttribute('data-single-open') !== 'true') return;

      var items = list.querySelectorAll('[data-faq-item]');
      items.forEach(function (item) {
        item.addEventListener('toggle', function () {
          if (!item.open) return;
          items.forEach(function (other) {
            if (other !== item) other.open = false;
          });
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product FAQs",
  "tag": "section",
  "class": "section-product-faqs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Only one item open at a time",
      "default": true
    },
    {
      "type": "header",
      "content": "Fallback content"
    },
    {
      "type": "paragraph",
      "content": "Shown when the product has no custom.faq_content metafield set."
    },
    {
      "type": "metaobject",
      "id": "faq_object",
      "label": "FAQ object",
      "metaobject_type": "products_faqs"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 840
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e3e3e3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (icon & links)",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Product FAQs"
    }
  ]
}
{% endschema %}
