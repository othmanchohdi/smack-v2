{%- comment -%}
  Section: Ingredient / Benefits Grid (Ella 7.1.0 compatible)
  - 2 or 3 column responsive grid
  - Each card is a block: image, title, up to 3 colored tags, description
  - All CSS scoped under #shopify-section-{{ section.id }} to avoid bleed
{%- endcomment -%}

{%- liquid
  assign cols = section.settings.columns | plus: 0
  assign gap = section.settings.column_gap
  assign radius = section.settings.card_radius
  assign pad = section.settings.card_padding
  assign img_h = section.settings.image_height
  assign align = section.settings.text_align
  assign visible_tab_count = 0
  if section.settings.show_animal_tab
    assign visible_tab_count = visible_tab_count | plus: 1
  endif
  if section.settings.show_plant_tab
    assign visible_tab_count = visible_tab_count | plus: 1
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .ibg-wrap {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ibg-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto {{ section.settings.header_spacing }}px;
  }
  #shopify-section-{{ section.id }} .ibg-header h2 {
    margin: 0 0 12px;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ibg-header p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.subheading_color }};
  }
  #shopify-section-{{ section.id }} .ibg-tabs{display:flex;justify-content:center;gap:12px;margin:0 0 30px;}
  #shopify-section-{{ section.id }} .ibg-tab{padding:10px 22px;border:1px solid #ddd;background:#fff;cursor:pointer;border-radius:999px;font-weight:700;}
  #shopify-section-{{ section.id }} .ibg-tab.active{background:#111;color:#fff;}
  #shopify-section-{{ section.id }} .ibg-grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: {{ gap }}px;
  }
  #shopify-section-{{ section.id }} .ibg-card {
    background: var(--card-bg, #ffffff);
    border-radius: {{ radius }}px;
    padding: {{ pad }}px;
    text-align: {{ align }};
    box-shadow: 0 2px 14px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    {% if align == 'center' %}align-items: center;{% endif %}
  }
  #shopify-section-{{ section.id }} .ibg-card__media {
    height: {{ img_h }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
  }
  #shopify-section-{{ section.id }} .ibg-card__media img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .ibg-card__title {
    margin: 0 0 14px;
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.card_title_color }};
  }
  #shopify-section-{{ section.id }} .ibg-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    {% if align == 'center' %}justify-content: center;{% endif %}
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .ibg-card__tags:empty { display: none; margin: 0; }
  #shopify-section-{{ section.id }} .ibg-tag {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.2px;
  }
  #shopify-section-{{ section.id }} .ibg-card__text {
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.6;
    color: {{ section.settings.body_color }};
  }
  #shopify-section-{{ section.id }} .ibg-card__text p:last-child { margin-bottom: 0; }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .ibg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .ibg-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<div class="ibg-wrap">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ibg-header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if visible_tab_count > 1 -%}
      <div class="ibg-tabs" role="tablist" aria-label="Ingredient categories">
        {%- if section.settings.show_animal_tab -%}
          <button class="ibg-tab" type="button" data-filter="animal" role="tab">
            {{ section.settings.animal_tab_label | escape }}
          </button>
        {%- endif -%}
        {%- if section.settings.show_plant_tab -%}
          <button class="ibg-tab" type="button" data-filter="plant" role="tab">
            {{ section.settings.plant_tab_label | escape }}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ibg-grid">
      {%- for block in section.blocks -%}
        <div class="ibg-card" data-type="{{ block.settings.ingredient_type }}" style="--card-bg: {{ block.settings.card_bg }};" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="ibg-card__media">
              {%- assign img = block.settings.image -%}
              <img
                src="{{ img | image_url: width: 600 }}"
                srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w"
                sizes="(max-width: 640px) 80vw, 300px"
                width="{{ img.width }}"
                height="{{ img.height }}"
                alt="{{ img.alt | default: block.settings.title | escape }}"
                loading="lazy">
            </div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="ibg-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          <div class="ibg-card__tags">
            {%- if block.settings.tag_1 != blank -%}
              <span class="ibg-tag" style="background:{{ block.settings.tag_1_bg }};color:{{ block.settings.tag_1_text }};">{{ block.settings.tag_1 }}</span>
            {%- endif -%}
            {%- if block.settings.tag_2 != blank -%}
              <span class="ibg-tag" style="background:{{ block.settings.tag_2_bg }};color:{{ block.settings.tag_2_text }};">{{ block.settings.tag_2 }}</span>
            {%- endif -%}
            {%- if block.settings.tag_3 != blank -%}
              <span class="ibg-tag" style="background:{{ block.settings.tag_3_bg }};color:{{ block.settings.tag_3_text }};">{{ block.settings.tag_3 }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.description != blank -%}
            <div class="ibg-card__text">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>


<script>
(() => {
  const section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;

  const tabs = section.querySelectorAll('.ibg-tab');
  const cards = section.querySelectorAll('.ibg-card');
  const fallbackFilter = {% if section.settings.show_animal_tab %}'animal'{% elsif section.settings.show_plant_tab %}'plant'{% else %}null{% endif %};

  function filterCards(type) {
    cards.forEach((card) => {
      card.hidden = !type || card.dataset.type !== type;
    });

    tabs.forEach((tab) => {
      const isActive = tab.dataset.filter === type;
      tab.classList.toggle('active', isActive);
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => filterCards(tab.dataset.filter));
  });

  filterCards(tabs.length ? tabs[0].dataset.filter : fallbackFilter);
})();
</script>

