{%- comment -%}
  wholesale-gate.liquid
  =====================
  Rendered in <head> via layout/theme.liquid.
  Gates wholesale-only collections, pages, and products, and redirects
  wholesale customers away from retail-only collections, pages, products,
  and (optionally) the home page.

  All config comes from theme settings (Customizer > Wholesale).
{%- endcomment -%}

{%- if settings.wholesale_gate_enabled -%}

  {%- comment -%} Resolve the wholesale customer tag from settings {%- endcomment -%}
  {%- assign _ws_tag = settings.wholesale_customer_tag | default: 'W1' | strip -%}

  {%- comment -%} Check if the logged-in customer carries the wholesale tag {%- endcomment -%}
  {%- assign _ws_customer = false -%}
  {%- if customer -%}
    {%- for _t in customer.tags -%}
      {%- if _t == _ws_tag -%}
        {%- assign _ws_customer = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- assign _ws_redirect = settings.wholesale_redirect_url | default: '/pages/how-to-order' -%}

  {%- comment -%}
    GATE — Wholesale-only collections
    Non-wholesale visitors are redirected: guests → /login, retail customers → redirect page.
  {%- endcomment -%}
  {%- if template contains 'collection' and _ws_customer == false -%}
    {%- assign _gate = false -%}
    {%- for i in (1..10) -%}
      {%- assign _col_key = 'wholesale_gated_col_' | append: i -%}
      {%- assign _col_handle = settings[_col_key] -%}
      {%- if _col_handle != blank and collection.handle == _col_handle -%}
        {%- assign _gate = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if _gate -%}
      <meta name="robots" content="NOINDEX,NOFOLLOW,NOARCHIVE,NOSNIPPET">
      {%- if customer -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
      {%- else -%}
        <script>window.location.replace('/account/login?return_url={{ request.path | url_encode }}');</script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    GATE — Wholesale-only pages
  {%- endcomment -%}
  {%- if template contains 'page' and _ws_customer == false -%}
    {%- assign _gate_page = false -%}
    {%- for i in (1..5) -%}
      {%- assign _page_key = 'wholesale_gated_page_' | append: i -%}
      {%- assign _page_handle = settings[_page_key] -%}
      {%- if _page_handle != blank and page.handle == _page_handle -%}
        {%- assign _gate_page = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if _gate_page -%}
      <meta name="robots" content="NOINDEX,NOFOLLOW,NOARCHIVE,NOSNIPPET">
      {%- if customer -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
      {%- else -%}
        <script>window.location.replace('/account/login?return_url={{ request.path | url_encode }}');</script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    REVERSE GATE — Redirect wholesale customers away from retail-only collections.
  {%- endcomment -%}
  {%- if _ws_customer and template contains 'collection' -%}
    {%- for i in (1..10) -%}
      {%- assign _retail_key = 'wholesale_retail_col_' | append: i -%}
      {%- assign _retail_handle = settings[_retail_key] -%}
      {%- if _retail_handle != blank and collection.handle == _retail_handle -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- comment -%}
    REVERSE GATE — Redirect wholesale customers away from retail-only pages.
  {%- endcomment -%}
  {%- if _ws_customer and template contains 'page' -%}
    {%- for i in (1..5) -%}
      {%- assign _retail_page_key = 'wholesale_retail_page_' | append: i -%}
      {%- assign _retail_page_handle = settings[_retail_page_key] -%}
      {%- if _retail_page_handle != blank and page.handle == _retail_page_handle -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- comment -%}
    REVERSE GATE — Optionally redirect wholesale customers away from the home page.
  {%- endcomment -%}
  {%- if _ws_customer and settings.wholesale_gate_home_enabled and template == 'index' -%}
    <script>window.location.replace({{ _ws_redirect | json }});</script>
  {%- endif -%}

  {%- comment -%}
    GATE — Wholesale-only products.
    Products carrying the wholesale product tag are only visible to wholesale
    customers: guests → /login, retail customers → redirect page.
    Wholesale customers are redirected away from products that do NOT carry
    the tag, so they never land on retail-only products either.
  {%- endcomment -%}
  {%- if template contains 'product' -%}
    {%- assign _ws_product_tag = settings.wholesale_product_tag | default: 'wholesale' | strip -%}
    {%- assign _ws_product = false -%}
    {%- for _t in product.tags -%}
      {%- if _t == _ws_product_tag -%}
        {%- assign _ws_product = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if _ws_product and _ws_customer == false -%}
      <meta name="robots" content="NOINDEX,NOFOLLOW,NOARCHIVE,NOSNIPPET">
      {%- if customer -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
      {%- else -%}
        <script>window.location.replace('/account/login?return_url={{ request.path | url_encode }}');</script>
      {%- endif -%}
    {%- elsif _ws_product == false and _ws_customer -%}
      <script>window.location.replace({{ _ws_redirect | json }});</script>
    {%- endif -%}
  {%- endif -%}

{%- endif -%}
