{%- comment -%}
  wholesale-gate.liquid
  =====================
  Rendered in <head> via layout/theme.liquid.
  Gates wholesale-only collections and pages, and redirects
  wholesale customers away from retail-only collections.

  All config comes from theme settings (Customizer > Wholesale).
{%- endcomment -%}

{%- if settings.wholesale_gate_enabled -%}

  {%- comment -%} Resolve the wholesale customer tag from settings {%- endcomment -%}
  {%- assign _ws_tag = settings.wholesale_customer_tag | default: 'W1' | strip -%}

  {%- comment -%} Check if the logged-in customer carries the wholesale tag {%- endcomment -%}
  {%- assign _ws_customer = false -%}
  {%- if customer -%}
    {%- for _t in customer.tags -%}
      {%- if _t == _ws_tag -%}
        {%- assign _ws_customer = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- assign _ws_redirect = settings.wholesale_redirect_url | default: '/pages/how-to-order' -%}

  {%- comment -%}
    GATE — Wholesale-only collections
    Non-wholesale visitors are redirected: guests → /login, retail customers → redirect page.
  {%- endcomment -%}
  {%- if template contains 'collection' and _ws_customer == false -%}
    {%- assign _gated_cols = sections['wholesale_config'].settings.gated_collections -%}
    {%- assign _gate = false -%}
    {%- for _col in _gated_cols -%}
      {%- if collection.handle == _col.handle -%}
        {%- assign _gate = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if _gate -%}
      <meta name="robots" content="NOINDEX,NOFOLLOW,NOARCHIVE,NOSNIPPET">
      {%- if customer -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
      {%- else -%}
        <script>window.location.replace('/account/login?return_url={{ request.path | url_encode }}');</script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    GATE — Wholesale-only pages (page_list doesn't exist in Shopify; using individual page pickers)
  {%- endcomment -%}
  {%- if template contains 'page' and _ws_customer == false -%}
    {%- assign _gate_page = false -%}
    {%- for i in (1..3) -%}
      {%- assign _page_key = 'wholesale_gated_page_' | append: i -%}
      {%- assign _page_handle = settings[_page_key] -%}
      {%- if _page_handle != blank and page.handle == _page_handle -%}
        {%- assign _gate_page = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if _gate_page -%}
      <meta name="robots" content="NOINDEX,NOFOLLOW,NOARCHIVE,NOSNIPPET">
      {%- if customer -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
      {%- else -%}
        <script>window.location.replace('/account/login?return_url={{ request.path | url_encode }}');</script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    REVERSE GATE — Redirect wholesale customers away from retail-only collections.
  {%- endcomment -%}
  {%- if _ws_customer and template contains 'collection' -%}
    {%- assign _retail_cols = sections['wholesale_config'].settings.retail_redirect_collections -%}
    {%- for _rcol in _retail_cols -%}
      {%- if collection.handle == _rcol.handle -%}
        <script>window.location.replace({{ _ws_redirect | json }});</script>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

{%- endif -%}
